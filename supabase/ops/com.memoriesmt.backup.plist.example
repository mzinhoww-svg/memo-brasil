<?xml version="1.0" encoding="UTF-8"?>
<!-- EXEMPLO (não instalado). Agendador do SEU Mac: roda o backup + rotação todo dia às 03:30 enquanto o Mac estiver ligado.
     Instalar (você): copie para ~/Library/LaunchAgents/com.memoriesmt.backup.plist, ajuste o caminho do repositório e rode:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.memoriesmt.backup.plist
     Limite honesto: Mac desligado ou sem rede = backup não roda; confira o log. Não é backup gerenciado. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.memoriesmt.backup</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>/CAMINHO/DO/REPOSITORIO/supabase/ops/backup_and_rotate.sh</string><string>--apply</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/memoriesmt-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/memoriesmt-backup.log</string>
</dict></plist>
