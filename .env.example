# Memo Brasil — variáveis de ambiente. Copie para .env (que fica no .gitignore).
# Nunca commite valores reais de segredo.
PORT=3210
DATA_DIR=./data
# PUBLIC_URL=https://album.exemplo.com   # domínio público usado no QR Code
# MASTER_TOKEN=                          # senha do admin master; sem ela, é gerada em data/master.token
VAPID_CONTACT=mailto:contato@exemplo.com
MAX_FOTOS_EVENTO=3000                    # teto de fotos por evento (padrão 3000)
# SENTRY_DSN=                            # opcional; sem ele, observabilidade de erros é no-op
LOG_RETENCAO_DIAS=30                     # retenção do hash de IP nos logs

# Retenção (LGPD) usada por scripts/retencao.js.
# Dias após a revelação até apagar o evento (padrão 365).
RETENCAO_DIAS_APOS_REVELACAO=365
# Dias depois de revealAt para eventos que não abriram (padrão 180).
RETENCAO_DIAS_SEM_REVELACAO=180

# Pasta padrão do scripts/exportar-evento.js quando não se usa --saida (padrão ./exportacoes).
EXPORT_DIR=./exportacoes

# Retenção dos backups locais em dias (padrão 30). Nunca passa de retencaoDiasAposRevelacao.
BACKUP_RETENTION_DIAS=30
