# Lume — variáveis de ambiente. Copie para .env (que fica no .gitignore).
# Nunca commite valores reais de segredo.
PORT=3210
DATA_DIR=./data
# PUBLIC_URL=https://album.exemplo.com   # domínio público usado no QR Code
# MASTER_TOKEN=                          # senha do admin master; sem ela, é gerada em data/master.token
VAPID_CONTACT=mailto:contato@exemplo.com
TRUST_PROXY=0                            # nº de proxies confiáveis na frente (define o req.ip do rate limit)

# Anti-spam do cadastro aberto (item 13)
# TURNSTILE_SITE_KEY=                    # Cloudflare Turnstile; sem as duas chaves, fica desligado
# TURNSTILE_SECRET=
ANTISPAM_MAX_IP=5                        # criações por IP na janela
ANTISPAM_MAX_EMAIL=3                     # criações por e-mail na janela
ANTISPAM_MAX_DIA_IP=20                   # criações por IP por dia
ANTISPAM_JANELA_MIN=10                   # janela do rate limit, em minutos
