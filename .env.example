# Copie para .env e ajuste. NUNCA commite o .env com valores reais.
# O servidor lê estas variáveis do ambiente (o .env não é carregado automaticamente).

# Porta do servidor (padrão 3210).
PORT=3210

# Onde ficam db.json, fotos e audit.log (padrão ./data).
DATA_DIR=./data

# Domínio público usado no QR Code e nos links (ex.: https://album.exemplo.com.br).
PUBLIC_URL=

# Senha do admin master. Sem ela, o servidor gera data/master.token.
MASTER_TOKEN=

# Contato das notificações push (mailto: ou URL).
VAPID_CONTACT=

# Retenção (LGPD) usada por scripts/retencao.js.
# Dias após a revelação até apagar o evento (padrão 365).
RETENCAO_DIAS_APOS_REVELACAO=365
# Dias desde a criação para eventos que nunca foram revelados (padrão 180).
RETENCAO_DIAS_SEM_REVELACAO=180

# Pasta padrão do scripts/exportar-evento.js quando não se usa --saida (padrão ./exportacoes).
EXPORT_DIR=./exportacoes
