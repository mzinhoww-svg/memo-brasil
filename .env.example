# Memo Brasil — variáveis de ambiente. Copie para .env (que fica no .gitignore).
# Nunca commite valores reais de segredo.
PORT=3210
DATA_DIR=./data
# PUBLIC_URL=https://album.exemplo.com   # domínio público usado no QR Code e nos links do e-mail
# MASTER_TOKEN=                          # senha do admin master; sem ela, é gerada em data/master.token
VAPID_CONTACT=mailto:contato@exemplo.com
# E-mail: "console" (padrão) só registra no log, sem token de acesso; "resend" envia de verdade.
EMAIL_PROVEDOR=console
# EMAIL_API_KEY=                         # Resend; em produção sem a chave o envio fica desativado e o erro é registrado
# EMAIL_FROM=Lume <ola@exemplo.com>      # remetente verificado no Resend
