# Lume (Memo Brasil) — modelo de variáveis de ambiente.
# Copie para .env e preencha os valores no servidor. NUNCA commite o .env.
# Este arquivo lista APENAS os nomes (sem valores, sem segredos).
#
#   cp .env.example .env && $EDITOR .env
#
# Regra: segredo só em variável de ambiente. Sem valor aqui de propósito.

# ── App / runtime (lidas hoje pelo server.js) ──
PORT=
DATA_DIR=
PUBLIC_URL=
MASTER_TOKEN=
VAPID_CONTACT=

# ── Publicação (Docker + Caddy) ──
# DOMINIO: domínio público com DNS apontando para a VPS. Sem barra no fim.
DOMINIO=
# IMAGE_TAG: etiqueta da imagem em uso; o deploy preenche com o commit. Opcional.
IMAGE_TAG=
NODE_ENV=

# ── Atrás do proxy reverso (Caddy) — ver docs/ACTIONS.md ──
# TRUST_PROXY: saltos de proxy confiáveis. Atrás de UM proxy (Caddy) use 1.
TRUST_PROXY=

# ── Autenticação / e-mail transacional ──
# EMAIL_PROVIDER: smtp (Brevo) em produção; console só em dev/teste (recusado em produção).
EMAIL_PROVIDER=
# SMTP_HOST: padrão smtp-relay.brevo.com. SMTP_PORT: padrão 587 (STARTTLS); 465 = TLS direto.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# SMTP_PASS: a chave SMTP do Brevo. SEGREDO — nunca commitar.
SMTP_PASS=
# EMAIL_FROM: remetente verificado. MAIL_FROM é nome alternativo aceito.
EMAIL_FROM=
MAIL_FROM=
# EMAIL_VERIFICADOS: endereços que podem receber o aviso de revelação, separados por
# vírgula, enquanto a confirmação por link mágico (#9) não entra.
EMAIL_VERIFICADOS=
# EMAIL_TIMEOUT_MS / SMTP_TIMEOUT_MS: limites de tempo (padrão 10000ms).
EMAIL_TIMEOUT_MS=
SMTP_TIMEOUT_MS=
# EMAIL_CONSOLE_PERMITIDO=sim autoriza o console em produção (só para ensaio).
EMAIL_CONSOLE_PERMITIDO=
EMAIL_API_KEY=
SESSION_SECRET=
MASTER_TOTP_KEY=
MASTER_EMERGENCY=
MASTER_TOKEN_COMPAT=

# ── Observabilidade (item 11) ──
SENTRY_DSN=

# ── Backup externo e cifra (obrigatória em produção; ver docs/deploy.md) ──
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_RETENTION_DIAS=
# BACKUP_PASSPHRASE: senha da cifra simétrica do backup (escolha uma).
BACKUP_PASSPHRASE=
# BACKUP_GPG_KEY: alternativa à senha — id/chave pública do destinatário gpg.
BACKUP_GPG_KEY=
