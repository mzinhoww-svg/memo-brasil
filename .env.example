# Lume (Memo Brasil) — modelo de variáveis de ambiente.
# Copie para .env e preencha os valores no servidor. NUNCA commite o .env.
# Este arquivo lista APENAS os nomes (sem valores, sem segredos).
#
#   cp .env.example .env && $EDITOR .env
#
# Regra: segredo só em variável de ambiente. Sem valor aqui de propósito.

# ── App / runtime (lidas hoje pelo server.js) ──
PORT=
DATA_DIR=
PUBLIC_URL=
MASTER_TOKEN=
VAPID_CONTACT=

# ── Publicação (Docker + Caddy) ──
# DOMINIO: domínio público com DNS apontando para a VPS. Sem barra no fim.
DOMINIO=
# IMAGE_TAG: etiqueta da imagem em uso; o deploy preenche com o commit. Opcional.
IMAGE_TAG=
NODE_ENV=

# ── Atrás do proxy reverso (Caddy) — ver docs/ACTIONS.md ──
# TRUST_PROXY: saltos de proxy confiáveis. Atrás de UM proxy (Caddy) use 1.
TRUST_PROXY=

# ── Autenticação / e-mail transacional (PR de auth) ──
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SESSION_SECRET=
MASTER_TOTP_KEY=
MASTER_EMERGENCY=
MASTER_TOKEN_COMPAT=

# ── Observabilidade (item 11) ──
SENTRY_DSN=

# ── Backup externo e cifra (obrigatória em produção; ver docs/deploy.md) ──
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_RETENTION_DIAS=
# BACKUP_PASSPHRASE: senha da cifra simétrica do backup (escolha uma).
BACKUP_PASSPHRASE=
# BACKUP_GPG_KEY: alternativa à senha — id/chave pública do destinatário gpg.
BACKUP_GPG_KEY=
